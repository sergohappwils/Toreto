function F.GetTargetDifficulty()
    local md = S.ReplicatedStorage:FindFirstChild("MatchData")
    local mapId = md and md:FindFirstChild("MapId") and tostring(md.MapId.Value) or ""
    if Config.AutoDetectEventDiff and State.MapDatas and mapId ~= "" then
        local mapInfo = State.MapDatas[mapId]
        if mapInfo and type(mapInfo.OverrideDifficulties) == "table" and #mapInfo.OverrideDifficulties > 0 then
            return tostring(mapInfo.OverrideDifficulties[1])
        end
    end
    return Config.TargetDifficulty
end

function F.SafeClickPlayAgainButton()
    local pg = State.LocalPlayer and State.LocalPlayer:FindFirstChild("PlayerGui")
    local matchGui = pg and pg:FindFirstChild("Match")
    local finishGui = matchGui and matchGui:FindFirstChild("MatchFinish")
    local endOpts = finishGui and finishGui:FindFirstChild("MatchFinishFrame") and finishGui.MatchFinishFrame:FindFirstChild("EndOptions")
    local paBtn = endOpts and endOpts:FindFirstChild("PlayAgain") and endOpts.PlayAgain:FindFirstChild("ButtonFrame") and endOpts.PlayAgain.ButtonFrame:FindFirstChild("PlayAgainButton")
    if not (paBtn and paBtn:IsA("GuiButton") and paBtn.Visible and finishGui.Visible) then
        return false
    end
    if paBtn.Text == "Cancel Play Again" then
        return true
    end
    local ok = pcall(function()
        local inset = S.GuiService:GetGuiInset()
        local center = paBtn.AbsolutePosition + (paBtn.AbsoluteSize * 0.5) + inset
        S.VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
        task.wait(0.05)
        S.VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
    end)
    return ok
end

function F.StartAutomationLoops()
    F.TrackConn(State.LocalPlayer.Idled:Connect(function()
        if Controller.Running and Config.AntiAFK then
            pcall(function()
                S.VirtualUser:CaptureController()
                S.VirtualUser:ClickButton2(Vector2.new())
            end)
        end
    end))

    F.SpawnLoop(function()
        while Controller.Running do
            local now = os.clock()
            local isLobby = S.ReplicatedStorage:FindFirstChild("IsLobby")
            local inMainGame = (not isLobby) or (isLobby.Value == false)

            if inMainGame then
                local md = S.ReplicatedStorage:FindFirstChild("MatchData")
                local curWave = md and md:FindFirstChild("CurrentWave") and tonumber(md.CurrentWave.Value) or 0
                local curTimer = md and md:FindFirstChild("MatchTimer") and tonumber(md.MatchTimer.Value) or 0

                if curWave == 0 and (State.LastKnownWave > 0 or (State.LastKnownTimer > 5 and curTimer < State.LastKnownTimer)) then
                    State.MatchEnded = false
                    State.EndActionSentForMatch = false
                    State.MatchFinishShownAt = nil
                    State.MatchStartClock = now
                end
                if State.LastKnownWave <= 0 and curWave >= 1 then
                    State.MatchEnded = false
                    State.EndActionSentForMatch = false
                    State.MatchFinishShownAt = nil
                    if curTimer <= 5 then State.MatchStartClock = now - curTimer end
                    if Config.AutoPlayMacro and #MacroState.Steps > 0 and not MacroState.IsPlaying and not MacroState.IsRecording then
                        F.StartPlayback()
                    end
                end
                State.LastKnownWave = curWave
                State.LastKnownTimer = curTimer

                local pg = State.LocalPlayer:FindFirstChild("PlayerGui")
                local finishGui = pg and pg:FindFirstChild("Match") and pg.Match:FindFirstChild("MatchFinish")
                if finishGui and finishGui:IsA("GuiObject") then
                    if finishGui.Visible then
                        State.MatchEnded = true
                        State.MatchFinishShownAt = State.MatchFinishShownAt or now
                    elseif State.MatchEnded and curWave == 0 and curTimer < 10 then
                        State.MatchEnded = false
                        State.EndActionSentForMatch = false
                        State.MatchFinishShownAt = nil
                    end
                end

                if Config.AutoVoteDifficulty and (now - State.Timers.Vote >= 1.0) then
                    local votingFolder = S.ReplicatedStorage:FindFirstChild("VotingFolder")
                    local votingVal = md and md:FindFirstChild("Voting")
                    if votingFolder and (not votingVal or tonumber(votingVal.Value) > 0) then
                        local pFolder = votingFolder:FindFirstChild("Players")
                        local myVote = pFolder and pFolder:FindFirstChild("Player_" .. tostring(State.LocalPlayer.UserId))
                        local targetDiff = F.GetTargetDifficulty()
                        if not myVote or tostring(myVote.Value) ~= targetDiff then
                            State.Timers.Vote = now
                            F.FireEvent("VoteMap", targetDiff)
                        end
                    end
                end

                if (Config.AutoSkipWaves or Config.AutoSkipIntermission) and (now - State.Timers.SkipWave >= 1.0) then
                    local canSkip = md and md:FindFirstChild("CanSkip")
                    local votingVal = md and md:FindFirstChild("Voting")
                    local skipFolder = md and md:FindFirstChild("VoteSkipPlayers")
                    if canSkip and canSkip.Value == true and (not votingVal or tonumber(votingVal.Value) == 0) then
                        local want = (curWave == 0 and Config.AutoSkipIntermission) or (curWave > 0 and Config.AutoSkipWaves)
                        local voted = skipFolder and skipFolder:FindFirstChild(tostring(State.LocalPlayer.UserId))
                        if want and not voted then
                            State.Timers.SkipWave = now
                            F.FireEvent("VoteSkipWave")
                        end
                    end
                end

                if State.MatchEnded and not State.EndActionSentForMatch and Config.AutoEndAction ~= "None" then
                    if State.MatchFinishShownAt and (now - State.MatchFinishShownAt >= Config.AutoEndDelay) and (now - State.Timers.EndAction >= 1.5) then
                        State.Timers.EndAction = now
                        if Config.AutoEndAction == "PlayAgain" then
                            if F.ResolveEventId("PlayMatchAgain") then
                                F.FireEvent("PlayMatchAgain")
                                State.EndActionSentForMatch = true
                                F.SetStatus("Auto PlayAgain (Remote)")
                            elseif F.SafeClickPlayAgainButton() then
                                State.EndActionSentForMatch = true
                                F.SetStatus("Auto PlayAgain (Safe UI Click)")
                            end
                        elseif Config.AutoEndAction == "Lobby" then
                            if F.FireEvent("TeleportToLobby") then
                                State.EndActionSentForMatch = true
                                F.SetStatus("Auto Return to Lobby")
                            end
                        end
                    end
                end
            end

            if now - State.Timers.EqSync >= 4.0 then
                State.Timers.EqSync = now
                F.SyncEquippedTroops()
            end
            task.wait(0.25)
        end
    end)
end

