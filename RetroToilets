local function letterToNumber(ch)
    local num = tonumber(ch)
    if num then return num end
    local idx = string.find("abcdefghijklmnopqrstuvwxyz-", string.lower(ch), 1, true)
    return tonumber(idx) or 0
end

function F.GetHashedEventName(eventName, mode)
    local guidObj, timeObj = State.MatchGuidObj, State.GameTimeValObj
    if not (guidObj and timeObj) then return nil end
    local guid = tostring(guidObj.Value)
    local gt = tonumber(timeObj.Value) or 1
    if guid ~= State.HashCacheGuid or gt ~= State.HashCacheTime then
        table.clear(State.HashCache)
        State.HashCacheGuid = guid
        State.HashCacheTime = gt
    end
    local cacheKey = tostring(mode) .. ":" .. tostring(eventName)
    if State.HashCache[cacheKey] then return State.HashCache[cacheKey] end

    local sub1 = string.sub(guid, gt, gt)
    local idx2 = math.clamp(gt + 3, 1, 32)
    local sub2 = string.sub(guid, idx2, idx2)
    local prefix = (mode == "FuncRecieve") and "FR_" or "UR_"

    if S.RunService:IsStudio() then
        local studioName = prefix .. tostring(eventName)
        State.HashCache[cacheKey] = studioName
        return studioName
    end

    local fmt = letterToNumber(sub2) > 17
        and "%s-%s_%s'%s:%s|%s/%s!%s=%s@%s(%s$%s*%s&%s^%s?%s{%s"
        or "%s/%s!%s=%s@%s(%s$%s*%s&%s^%s?%s{%s-%s_%s'%s:%s|%s"

    local pVer, cId = tostring(game.PlaceVersion), tostring(game.CreatorId)
    local pId, gId = tostring(game.PlaceId), tostring(game.GameId)
    local eStr = tostring(eventName)

    local formatted = string.format(
        fmt, eStr, pId, pVer, cId, sub1, sub2, eStr, pId,
        sub1, pVer, cId, gId, sub1, eStr, pId, sub1, sub2
    )

    local n1 = letterToNumber(sub1)
    local digest
    if n1 > 15 then digest = Hash.sha3_224(formatted)
    elseif n1 > 6 then digest = Hash.sha512_224(formatted)
    else digest = Hash.sha512_256(formatted) end

    local full = prefix .. digest
    State.HashCache[cacheKey] = full
    return full
end

function F.PackArgs(...)
    local packed = table.pack(...)
    local out, nilId = {}, State.NilIdentifier
    for i = 1, packed.n do
        out[i] = (packed[i] == nil) and nilId or packed[i]
    end
    return out
end

function F.UnpackArgs(tbl)
    if type(tbl) ~= "table" then return end
    local nilId, n = State.NilIdentifier, 0
    for k in pairs(tbl) do
        if type(k) == "number" and k > n then n = k end
    end
    local copy = {}
    for i = 1, n do
        copy[i] = (tbl[i] ~= nilId) and tbl[i] or nil
    end
    return table.unpack(copy, 1, n)
end

function F.ResolveEventId(eventName)
    if not State.IdStorage then return nil end
    local hashed = F.GetHashedEventName("Event-" .. eventName, "Event")
    if not hashed then return nil end
    local strVal = State.IdStorage:FindFirstChild(hashed)
    if strVal and strVal:IsA("StringValue") then return strVal.Value end
    return nil
end

function F.FireEvent(eventName, ...)
    if not State.DataRemote then return false end
    local id = F.ResolveEventId(eventName)
    if not id then return false end
    table.insert(State.OutboundQueue, F.PackArgs(...))
    table.insert(State.OutboundQueue, id)
    return true
end

function F.BindInboundEvent(eventName, callback)
    local hashed = F.GetHashedEventName("Event-" .. eventName, "Event")
    if not (hashed and State.IdStorage) then return end
    local function attach(child)
        if child and child.Name == hashed and child:IsA("StringValue") then
            State.InboundHandlers[child.Value] = State.InboundHandlers[child.Value] or {}
            table.insert(State.InboundHandlers[child.Value], callback)
        end
    end
    local existing = State.IdStorage:FindFirstChild(hashed)
    if existing then attach(existing) end
    F.TrackBridgeConn(State.IdStorage.ChildAdded:Connect(attach))
end

function F.InitNetwork()
    State.DataRemote = S.ReplicatedStorage:WaitForChild("dataRemoteEvent", 15)
    State.IdStorage = S.ReplicatedStorage:WaitForChild("identifierStorage", 15)
    State.MatchGuidObj = S.ReplicatedStorage:WaitForChild("MatchGuid", 15)
    State.GameTimeValObj = S.ReplicatedStorage:WaitForChild("GameTimeVal", 15)
    if not (State.DataRemote and State.IdStorage and State.MatchGuidObj and State.GameTimeValObj) then
        State.BridgeStatusText = "Missing RS"
        return false
    end

    local nilObj = State.IdStorage:WaitForChild("NilIdentifier", 10)
    if nilObj and nilObj:IsA("StringValue") then State.NilIdentifier = nilObj.Value end

    F.TrackBridgeConn(S.RunService.PostSimulation:Connect(function()
        if not Controller.Running then return end
        local q = State.OutboundQueue
        if #q > 0 and State.DataRemote then
            local batch = table.clone(q)
            table.clear(q)
            State.DataRemote:FireServer(batch)
        end
    end))

    F.TrackBridgeConn(State.DataRemote.OnClientEvent:Connect(function(packetMap)
        if not Controller.Running or type(packetMap) ~= "table" then return end
        for idChar, payloads in pairs(packetMap) do
            local handlers = State.InboundHandlers[idChar]
            if handlers and type(payloads) == "table" then
                for _, argsTbl in ipairs(payloads) do
                    for _, fn in ipairs(handlers) do
                        task.spawn(fn, F.UnpackArgs(argsTbl))
                    end
                end
            end
        end
    end))

    F.BindInboundEvent("ShowMatchFinishStat", function(_, _, _, _, _, _, won)
        State.MatchEnded = true
        State.MatchFinishShownAt = State.MatchFinishShownAt or os.clock()
        if MacroState.IsRecording then F.StopRecording() end
        if MacroState.IsPlaying then F.StopPlayback() end
        F.SetStatus(won and "Match Won!" or "Match Lost!")
    end)

    F.BindInboundEvent("ReplicaChange", function(replicaName, changes)
        if replicaName == ("PlayerData-" .. tostring(State.LocalPlayer.UserId)) and type(changes) == "table" then
            for _, entry in ipairs(changes) do
                if type(entry) == "table" and entry.Index == "EquippedTroops" then
                    task.delay(0.1, F.SyncEquippedTroops)
                    break
                end
            end
        end
    end)

    local testId = F.ResolveEventId("PlaceTroop")
    State.BridgeStatusText = testId and ("Wire OK (" .. testId .. ")") or "Wire Pending"
    return true
end

-- ============================================================================
-- 6. PLACEMENT MATH, BOUNDING BOX & HELPERS
-- ============================================================================
local function GetBoundingBox(target, cf, mode)
    local parts = typeof(target) == "Instance" and target:GetDescendants() or (type(target) == "table" and target or {})
    if mode == "CharacterPartsOnly" then
        local filtered = {}
        for _, v in ipairs(parts) do
            if typeof(v) == "Instance" and v:IsA("BasePart") and table.find(CHAR_PARTS, v.Name) then
                table.insert(filtered, v)
            end
        end
        if #filtered > 0 then parts = filtered end
    end
    local refCF = cf or CFrame.new()
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local found = false
    for _, v in ipairs(parts) do
        if typeof(v) == "Instance" and v:IsA("BasePart") then
            found = true
            local rel = refCF:ToObjectSpace(v.CFrame)
            local s = v.Size
            local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = rel:GetComponents()
            local ex = 0.5 * (math.abs(r00) * s.X + math.abs(r01) * s.Y + math.abs(r02) * s.Z)
            local ey = 0.5 * (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z)
            local ez = 0.5 * (math.abs(r20) * s.X + math.abs(r21) * s.Y + math.abs(r22) * s.Z)
            if x - ex < minX then minX = x - ex end
            if y - ey < minY then minY = y - ey end
            if z - ez < minZ then minZ = z - ez end
            if x + ex > maxX then maxX = x + ex end
            if y + ey > maxY then maxY = y + ey end
            if z + ez > maxZ then maxZ = z + ez end
        end
    end
    if not found then return refCF, Vector3.new(2, 5, 2) end
    local minV, maxV = Vector3.new(minX, minY, minZ), Vector3.new(maxX, maxY, maxZ)
    return (refCF - refCF.Position) + refCF:PointToWorldSpace((maxV + minV) * 0.5), maxV - minV
end

function F.GetTroopBoxData(troopId)
    local td = State.TroopDatas and State.TroopDatas[troopId]
    if not (td and td.Model) then return Vector3.new(2, 5, 2), Vector3.new(2, 5, 2) end
    local charTarget = td.Model:FindFirstChild("TroopModel") or td.Model
    local _, charSize = GetBoundingBox(charTarget, nil, "CharacterPartsOnly")
    local _, fullSize = GetBoundingBox(td.Model)
    return fullSize, Vector3.new(charSize.X, fullSize.Y, charSize.Z)
end

function F.UpdatePlacementFilters()
    local excl = {}
    local placing = workspace:FindFirstChild("PlacingModels")
    if placing then table.insert(excl, placing) end
    if State.LocalPlayer and State.LocalPlayer.Character then
        table.insert(excl, State.LocalPlayer.Character)
    end
    State.GroundRayParams.FilterDescendantsInstances = excl

    local snapExcl = table.clone(excl)
    for _, n in ipairs({ "Attackers", "Troops", "StunnedTroops" }) do
        local f = workspace:FindFirstChild(n)
        if f then table.insert(snapExcl, f) end
    end
    State.SnapRayParams.FilterDescendantsInstances = snapExcl

    local overlapInc = {}
    for _, n in ipairs({ "Troops", "StunnedTroops" }) do
        local f = workspace:FindFirstChild(n)
        if f then table.insert(overlapInc, f) end
    end
    State.TooNearOverlap.FilterDescendantsInstances = overlapInc
end

function F.CanPlaceAt(troopId, pivotCF)
    local ground = workspace:FindFirstChild("Ground")
    if not ground then return false end
    F.UpdatePlacementFilters()
    local fullSize, checkSize = F.GetTroopBoxData(troopId)
    local hit = workspace:Blockcast(
        pivotCF + Vector3.new(0, checkSize.Y / 2, 0),
        Vector3.new(checkSize.X, 0.05, checkSize.Z),
        Vector3.new(0, -checkSize.Y, 0),
        State.GroundRayParams
    )
    if not (hit and hit.Instance and hit.Instance:IsDescendantOf(ground)) then return false end
    if hit.Distance < (checkSize.Y - 0.2) then return false end
    if #State.TooNearOverlap.FilterDescendantsInstances > 0 then
        local bounds = workspace:GetPartBoundsInBox(pivotCF, fullSize + Vector3.new(0.1, 0.1, 0.1), State.TooNearOverlap)
        if #bounds > 0 then return false end
    end
    return true
end

function F.SnapPosToGround(troopId, pos)
    local ground = workspace:FindFirstChild("Ground")
    if not ground then return pos end
    F.UpdatePlacementFilters()
    local fullSize = F.GetTroopBoxData(troopId)
    local hit = workspace:Raycast(Vector3.new(pos.X, pos.Y + 8, pos.Z), Vector3.new(0, -24, 0), State.SnapRayParams)
    if hit and hit.Instance and hit.Instance:IsDescendantOf(ground) then
        return Vector3.new(pos.X, hit.Position.Y + fullSize.Y / 2, pos.Z)
    end
    return pos
end

function F.SolvePlacement(troopId, rawPos, rotIdx)
    local rIdx = math.clamp(math.floor(tonumber(rotIdx) or 1), 1, #ROTATIONS)
    local rotCF = CFrame.Angles(0, math.rad(ROTATIONS[rIdx]), 0)
    if F.CanPlaceAt(troopId, CFrame.new(rawPos) * rotCF) then return rawPos, rIdx end
    local snapped = F.SnapPosToGround(troopId, rawPos)
    if F.CanPlaceAt(troopId, CFrame.new(snapped) * rotCF) then return snapped, rIdx end
    for radius = 0.6, 5.4, 0.6 do
        for s = 0, 11 do
            local ang = (s / 12) * math.pi * 2
            local testPos = F.SnapPosToGround(troopId, Vector3.new(rawPos.X + math.cos(ang) * radius, rawPos.Y, rawPos.Z + math.sin(ang) * radius))
            if F.CanPlaceAt(troopId, CFrame.new(testPos) * rotCF) then return testPos, rIdx end
        end
    end
    return nil, rIdx
end

function F.GetTroopLimitGroupsList(troopId)
    local td = State.TroopDatas and State.TroopDatas[troopId]
    if not (td and td.LimitGroup) then return {} end
    if type(td.LimitGroup) == "string" then return { td.LimitGroup } end
    if type(td.LimitGroup) == "table" then return td.LimitGroup end
    return {}
end

function F.GetOwnedTroopModels()
    local result, lp = {}, State.LocalPlayer
    for _, folderName in ipairs({ "Troops", "StunnedTroops" }) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                if model:IsA("Model") then
                    local owner = model:FindFirstChild("TroopOwner")
                    if owner and owner:IsA("ObjectValue") and owner.Value == lp then
                        table.insert(result, model)
                    end
                end
            end
        end
    end
    return result
end

function F.CheckLimitGroupAllows(troopId)
    local groups = F.GetTroopLimitGroupsList(troopId)
    if #groups == 0 or not State.TroopsLimitGroups then return true end
    local owned = F.GetOwnedTroopModels()
    for _, grpName in ipairs(groups) do
        local grpInfo = State.TroopsLimitGroups[grpName]
        if grpInfo and type(grpInfo.Limit) == "number" then
            local count = 0
            for _, m in ipairs(owned) do
                if table.find(F.GetTroopLimitGroupsList(m.Name), grpName) then count += 1 end
            end
            if count >= grpInfo.Limit then return false, grpName end
        end
    end
    return true
end

function F.GetMoney()
    local ls = State.LocalPlayer and State.LocalPlayer:FindFirstChild("leaderstats")
    local money = ls and ls:FindFirstChild("Money")
    return (money and tonumber(money.Value)) or 0
end

function F.GetMatchWaveAndTime()
    local md = S.ReplicatedStorage:FindFirstChild("MatchData")
    local wave = (md and md:FindFirstChild("CurrentWave") and tonumber(md.CurrentWave.Value)) or 0
    local serverTimer = (md and md:FindFirstChild("MatchTimer") and tonumber(md.MatchTimer.Value)) or 0
    local elapsed = os.clock() - State.MatchStartClock
    if math.abs(elapsed - serverTimer) > 2.5 and serverTimer > 0 then
        State.MatchStartClock = os.clock() - serverTimer
        elapsed = serverTimer
    end
    return wave, math.max(0, math.round(elapsed * 100) / 100)
end

function F.GetTroopAnchorPosition(model)
    local center = model:FindFirstChild("CenterPart")
    if center and center:IsA("BasePart") then return center.Position end
    local ok, pivot = pcall(model.GetPivot, model)
    return ok and pivot.Position or Vector3.zero
end

function F.GetNearestRotationIndex(model)
    local target = model:FindFirstChild("TroopModel") or model
    local ok, pivot = pcall(target.GetPivot, target)
    if not ok then return 1 end
    local _, ry, _ = pivot:ToEulerAnglesYXZ()
    local deg, bestIdx, bestDiff = math.deg(ry), 1, math.huge
    for idx, rotDeg in ipairs(ROTATIONS) do
        local diff = math.abs(((deg - rotDeg + 180) % 360) - 180)
        if diff < bestDiff then bestDiff, bestIdx = diff, idx end
    end
    return bestIdx
end

function F.CanSellTroop(model)
    if not (model and model.Parent) then return false end
    if model:GetAttribute("CannotSell") == true then return false end
    local td = State.TroopDatas and State.TroopDatas[model.Name]
    if td and td.CanSell == false then return false end
    return true
end

local function isInTroopFolder(model)
    if not (model and model.Parent) then return false end
    local pName = model.Parent.Name
    return model.Parent.Parent == workspace and (pName == "Troops" or pName == "StunnedTroops")
end

-- ============================================================================
-- 7. STUN-AWARE RECORDING ENGINE
-- ============================================================================
function F.ClearRecordConnections()
    for _, c in ipairs(MacroState.RecordConns) do pcall(function() c:Disconnect() end) end
    table.clear(MacroState.RecordConns)
end

function F.PushRecordedStep(step)
    if not MacroState.IsRecording then return end
    local wave, mTime = F.GetMatchWaveAndTime()
    step.Wave = wave
    step.MatchTime = mTime
    step.Delta = math.max(0, math.round((mTime - State.LastRecordedMatchTime) * 100) / 100)
    State.LastRecordedMatchTime = mTime
    table.insert(MacroState.Steps, step)
    State.StepsDirty = true
    F.SetStatus(string.format("Rec #%d: %s %s (W%d)", #MacroState.Steps, step.Type, step.Troop or ("#" .. tostring(step.UnitId)), wave))
end

function F.AttachRecordedUnit(model, isPreExisting)
    if not MacroState.IsRecording or not (model and model:IsA("Model")) then return end
    if MacroState.ModelToUnitId[model] then return end

    task.spawn(function()
        local owner = model:WaitForChild("TroopOwner", 2)
        local lvlObj = model:WaitForChild("TroopLevel", 2)
        local tgtObj = model:WaitForChild("TroopTarget", 2)
        if not MacroState.IsRecording or not Controller.Running then return end
        if not (owner and owner:IsA("ObjectValue") and owner.Value == State.LocalPlayer) then return end
        if MacroState.ModelToUnitId[model] or not isInTroopFolder(model) then return end

        MacroState.RecordUnitCounter += 1
        local unitId = MacroState.RecordUnitCounter
        MacroState.ModelToUnitId[model] = unitId
        MacroState.RecordUnits[unitId] = {
            Model = model,
            Troop = model.Name,
            LastLevel = (lvlObj and tonumber(lvlObj.Value)) or 1,
            LastTarget = (tgtObj and tostring(tgtObj.Value)) or "First",
        }

        if not isPreExisting then
            local pos = F.GetTroopAnchorPosition(model)
            local td = State.TroopDatas and State.TroopDatas[model.Name]
            F.PushRecordedStep({
                Type = "Place",
                UnitId = unitId,
                Troop = model.Name,
                Pos = { math.round(pos.X * 1000) / 1000, math.round(pos.Y * 1000) / 1000, math.round(pos.Z * 1000) / 1000 },
                Rot = F.GetNearestRotationIndex(model),
                Cost = (td and td.Price) or 0,
            })
        end

        if lvlObj then
            table.insert(MacroState.RecordConns, lvlObj.Changed:Connect(function()
                if not MacroState.IsRecording then return end
                local rec = MacroState.RecordUnits[unitId]
                if not rec then return end
                local newLvl = tonumber(lvlObj.Value) or rec.LastLevel
                if newLvl > rec.LastLevel then
                    local td = State.TroopDatas and State.TroopDatas[model.Name]
                    local cost = 0
                    if td and type(td.GetNextLevelPrice) == "function" then
                        for l = rec.LastLevel, newLvl - 1 do
                            local ok, p = pcall(td.GetNextLevelPrice, l)
                            if ok and type(p) == "number" then cost += p end
                        end
                    end
                    rec.LastLevel = newLvl
                    F.PushRecordedStep({ Type = "Upgrade", UnitId = unitId, Troop = model.Name, Level = newLvl, Cost = cost })
                end
            end))
        end

        if tgtObj then
            table.insert(MacroState.RecordConns, tgtObj.Changed:Connect(function()
                if not MacroState.IsRecording then return end
                local rec = MacroState.RecordUnits[unitId]
                if not rec then return end
                local newTgt = tostring(tgtObj.Value)
                if newTgt ~= rec.LastTarget then
                    rec.LastTarget = newTgt
                    F.PushRecordedStep({ Type = "Target", UnitId = unitId, Troop = model.Name, Target = newTgt })
                end
            end))
        end
    end)
end

function F.HandleRecordedRemoval(model)
    local unitId = MacroState.ModelToUnitId[model]
    if not unitId then return end
    task.delay(0.2, function()
        if not MacroState.IsRecording or not Controller.Running or State.MatchEnded then return end
        if isInTroopFolder(model) then return end
        local md = S.ReplicatedStorage:FindFirstChild("MatchData")
        if md and md:FindFirstChild("CurrentWave") and tonumber(md.CurrentWave.Value) <= 0 then return end
        if MacroState.ModelToUnitId[model] == unitId then
            local rec = MacroState.RecordUnits[unitId]
            MacroState.ModelToUnitId[model] = nil
            MacroState.RecordUnits[unitId] = nil
            F.PushRecordedStep({ Type = "Sell", UnitId = unitId, Troop = rec and rec.Troop or model.Name })
        end
    end)
end

function F.StartRecording()
    if MacroState.IsPlaying then F.StopPlayback() end
    F.ClearRecordConnections()
    MacroState.IsRecording = true
    MacroState.Steps = {}
    MacroState.RecordUnitCounter = 0
    MacroState.RecordUnits = {}
    MacroState.ModelToUnitId = {}
    MacroState.TimingMode = Config.RecordOnlySellTimed and "Only Sell" or "Full"
    local _, curTime = F.GetMatchWaveAndTime()
    State.LastRecordedMatchTime = curTime

    for _, folderName in ipairs({ "Troops", "StunnedTroops" }) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do F.AttachRecordedUnit(child, true) end
            table.insert(MacroState.RecordConns, folder.ChildAdded:Connect(function(child) F.AttachRecordedUnit(child, false) end))
            table.insert(MacroState.RecordConns, folder.ChildRemoved:Connect(function(child) F.HandleRecordedRemoval(child) end))
        end
    end
    State.StepsDirty = true
    F.SetStatus("Recording (" .. MacroState.TimingMode .. ")...")
end

function F.StopRecording()
    if not MacroState.IsRecording then return end
    MacroState.IsRecording = false
    F.ClearRecordConnections()
    State.StepsDirty = true
    F.SetStatus("Stopped Rec (" .. #MacroState.Steps .. " steps)")
end

-- ============================================================================
-- 8. REPLAY / PLAYBACK ENGINE & QUICK ACTIONS
-- ============================================================================
function F.GetEffectiveTimingMode()
    return (Config.PlaybackTimingOverride ~= "From Macro") and Config.PlaybackTimingOverride or (MacroState.TimingMode or "Full")
end

function F.WaitIfStunned(model)
    if not Config.WaitIfStunned then return true end
    if not (model and model.Parent) then return false end
    local stunned = workspace:FindFirstChild("StunnedTroops")
    if stunned and model.Parent == stunned then
        F.SetStatus("Waiting (Stunned): " .. model.Name)
        while Controller.Running and MacroState.IsPlaying and model.Parent == stunned do
            task.wait(0.15)
        end
    end
    return Controller.Running and MacroState.IsPlaying and isInTroopFolder(model)
end

function F.FindFallbackUnit(step)
    local mapped = {}
    for _, m in pairs(MacroState.PlayUnitMap) do mapped[m] = true end
    for _, m in ipairs(F.GetOwnedTroopModels()) do
        if not mapped[m] and (not step.Troop or m.Name == step.Troop) then return m end
    end
    return nil
end

function F.WaitForSpawnedTroop(troopId, targetPos, snapshotSet, timeoutSec)
    local deadline, lp = os.clock() + (timeoutSec or 3.0), State.LocalPlayer
    while os.clock() < deadline and Controller.Running and MacroState.IsPlaying do
        local bestModel, bestDist = nil, math.huge
        for _, folderName in ipairs({ "Troops", "StunnedTroops" }) do
            local folder = workspace:FindFirstChild(folderName)
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Model") and not snapshotSet[child] and child.Name == troopId then
                        local owner = child:FindFirstChild("TroopOwner")
                        if owner and owner:IsA("ObjectValue") and owner.Value == lp then
                            local dist = (F.GetTroopAnchorPosition(child) - targetPos).Magnitude
                            if dist < bestDist then bestDist, bestModel = dist, child end
                        end
                    end
                end
            end
        end
        if bestModel then return bestModel end
        task.wait(0.08)
    end
    return nil
end

function F.ExecuteMacroStep(step)
    local mode = F.GetEffectiveTimingMode()
    local needWave, needTime = tonumber(step.Wave) or 1, tonumber(step.MatchTime) or 0
    local gateWave = (mode == "Full") or (mode == "Only Sell" and step.Type == "Sell") or (mode == "Cash Only" and step.Type == "Sell")
    local gateTime = (mode == "Full") or (mode == "Only Sell" and step.Type == "Sell")

    if gateWave or gateTime then
        while Controller.Running and MacroState.IsPlaying do
            if State.MatchEnded then return false end
            local curWave, curTime = F.GetMatchWaveAndTime()
            if ((not gateWave) or curWave >= needWave) and ((not gateTime) or curTime >= needTime) then break end
            F.SetStatus(string.format("Step %d/%d Wait W%d %.1fs", MacroState.CurrentStep, #MacroState.Steps, needWave, needTime))
            task.wait(0.15)
        end
    end
    if not Controller.Running or not MacroState.IsPlaying or State.MatchEnded then return false end

    local paceDelay = Config.SafePacing and 0.30 or 0.14
    local since = os.clock() - State.LastActionClock
    if since < paceDelay then task.wait(paceDelay - since) end

    if step.Type == "Place" then
        local td = State.TroopDatas and State.TroopDatas[step.Troop]
        if not td then return true end
        if not F.IsTroopEquipped(step.Troop) then
            F.SetStatus("Not equipped: " .. tostring(step.Troop))
            task.wait(1.0)
            return false
        end
        local limitOk, grp = F.CheckLimitGroupAllows(step.Troop)
        if not limitOk then
            F.SetStatus("Limit (" .. tostring(grp) .. ") - skip")
            return true
        end
        local price = tonumber(td.Price) or tonumber(step.Cost) or 0
        while Controller.Running and MacroState.IsPlaying and not State.MatchEnded and F.GetMoney() < price do
            F.SetStatus(string.format("Need $%d for %s", price, step.Troop))
            task.wait(0.2)
        end
        if not Controller.Running or not MacroState.IsPlaying or State.MatchEnded then return false end

        local pArr = step.Pos or { 0, 0, 0 }
        local rawPos = Vector3.new(tonumber(pArr[1]) or 0, tonumber(pArr[2]) or 0, tonumber(pArr[3]) or 0)
        local finalPos, rotIdx = F.SolvePlacement(step.Troop, rawPos, step.Rot or 1)
        if not finalPos then
            F.SetStatus("Blocked: " .. step.Troop)
            task.wait(0.4)
            return false
        end

        local snapshot = {}
        for _, m in ipairs(F.GetOwnedTroopModels()) do snapshot[m] = true end

        F.SetStatus("Placing " .. step.Troop)
        State.LastActionClock = os.clock()
        if not F.FireEvent("PlaceTroop", step.Troop, finalPos, rotIdx) then return false end

        local spawned = F.WaitForSpawnedTroop(step.Troop, finalPos, snapshot, 3.0)
        if spawned then
            MacroState.PlayUnitMap[step.UnitId] = spawned
            return true
        end
        return false

    elseif step.Type == "Upgrade" then
        if MacroState.SoldUnits[step.UnitId] then return true end
        local model = MacroState.PlayUnitMap[step.UnitId]
        if not (model and model.Parent) then
            model = F.FindFallbackUnit(step)
            if model then MacroState.PlayUnitMap[step.UnitId] = model else return false end
        end
        if not F.WaitIfStunned(model) then return false end

        local td = State.TroopDatas and State.TroopDatas[model.Name]
        local lvlObj = model:FindFirstChild("TroopLevel")
        if not (td and lvlObj) then return true end
        local maxLvl = (td.GetMaxLevel and td.GetMaxLevel()) or 99
        local targetLvl = math.min(tonumber(step.Level) or (tonumber(lvlObj.Value) + 1), maxLvl)

        while Controller.Running and MacroState.IsPlaying and not State.MatchEnded do
            if not isInTroopFolder(model) or not F.WaitIfStunned(model) then return false end
            local curLvl = tonumber(lvlObj.Value) or 1
            if curLvl >= targetLvl or curLvl >= maxLvl then return true end
            local nextPrice = td.GetNextLevelPrice and td.GetNextLevelPrice(curLvl)
            if type(nextPrice) ~= "number" then return true end
            while Controller.Running and MacroState.IsPlaying and not State.MatchEnded and F.GetMoney() < nextPrice do
                F.SetStatus(string.format("Need $%d Upg %s Lv%d", nextPrice, model.Name, curLvl + 1))
                task.wait(0.2)
            end
            if not Controller.Running or not MacroState.IsPlaying or State.MatchEnded then return false end

            F.SetStatus(string.format("Upgrading %s -> Lv%d", model.Name, curLvl + 1))
            State.LastActionClock = os.clock()
            F.FireEvent("UpgradeTroop", model)

            local waitEnd = os.clock() + 2.0
            while os.clock() < waitEnd and Controller.Running and MacroState.IsPlaying do
                if (tonumber(lvlObj.Value) or curLvl) > curLvl then break end
                task.wait(0.08)
            end
            if (tonumber(lvlObj.Value) or curLvl) <= curLvl then return false end
            task.wait(Config.SafePacing and 0.22 or 0.1)
        end
        return false

    elseif step.Type == "Target" then
        if MacroState.SoldUnits[step.UnitId] then return true end
        local model = MacroState.PlayUnitMap[step.UnitId]
        if not (model and isInTroopFolder(model)) then return true end
        if not F.WaitIfStunned(model) then return false end
        local tgtObj = model:FindFirstChild("TroopTarget")
        if not tgtObj then return true end
        local desired = tostring(step.Target or "First")
        for _ = 1, 6 do
            if not Controller.Running or not MacroState.IsPlaying or State.MatchEnded then return false end
            local cur = tostring(tgtObj.Value)
            if cur == desired then return true end
            State.LastActionClock = os.clock()
            F.FireEvent("ChangeTargetting", model)
            local deadline = os.clock() + 1.0
            while os.clock() < deadline and tostring(tgtObj.Value) == cur do task.wait(0.06) end
        end
        return tostring(tgtObj.Value) == desired

    elseif step.Type == "Sell" then
        if MacroState.SoldUnits[step.UnitId] then return true end
        local model = MacroState.PlayUnitMap[step.UnitId]
        if not (model and isInTroopFolder(model)) then
            MacroState.SoldUnits[step.UnitId] = true
            return true
        end
        if not F.CanSellTroop(model) then return true end
        if not F.WaitIfStunned(model) then return false end

        F.SetStatus("Selling " .. model.Name)
        State.LastActionClock = os.clock()
        F.FireEvent("SellTroop", model)
        local waitEnd = os.clock() + 2.5
        while os.clock() < waitEnd and Controller.Running and MacroState.IsPlaying do
            if not isInTroopFolder(model) then
                MacroState.SoldUnits[step.UnitId] = true
                MacroState.PlayUnitMap[step.UnitId] = nil
                return true
            end
            task.wait(0.08)
        end
        return false
    end
    return true
end

function F.StartPlayback()
    if #MacroState.Steps == 0 then
        F.SetStatus("No macro steps")
        return false
    end
    if MacroState.IsRecording then F.StopRecording() end
    if MacroState.IsPlaying then return true end

    MacroState.IsPlaying = true
    MacroState.CurrentStep = 1
    MacroState.SoldUnits = {}
    MacroState.PlayUnitMap = {}
    MacroState.StepFailCount = 0
    State.StepsDirty = true
    F.SetStatus("Replaying (" .. #MacroState.Steps .. " steps)")

    F.SpawnLoop(function()
        while Controller.Running and MacroState.IsPlaying do
            local isLobby = S.ReplicatedStorage:FindFirstChild("IsLobby")
            if isLobby and isLobby.Value == true then
                F.SetStatus("In Lobby")
                task.wait(0.5)
                continue
            end
            if State.MatchEnded then
                task.wait(0.4)
                continue
            end
            local stepIdx = MacroState.CurrentStep
            if stepIdx > #MacroState.Steps then
                F.SetStatus("Replay Done (" .. #MacroState.Steps .. " steps)")
                MacroState.IsPlaying = false
                State.StepsDirty = true
                break
            end
            local ok, done = pcall(F.ExecuteMacroStep, MacroState.Steps[stepIdx])
            if not Controller.Running or not MacroState.IsPlaying then break end
            if ok and done then
                MacroState.CurrentStep += 1
                MacroState.StepFailCount = 0
                State.StepsDirty = true
            else
                MacroState.StepFailCount += 1
                if MacroState.StepFailCount >= 8 then
                    MacroState.CurrentStep += 1
                    MacroState.StepFailCount = 0
                    State.StepsDirty = true
                else
                    task.wait(0.4)
                end
            end
        end
    end)
    return true
end

function F.StopPlayback()
    if not MacroState.IsPlaying then return end
    MacroState.IsPlaying = false
    State.StepsDirty = true
    F.SetStatus("Paused at step " .. tostring(MacroState.CurrentStep))
end

function F.UpgradeAllUnits(maxOut)
    F.SpawnLoop(function()
        for _, m in ipairs(F.GetOwnedTroopModels()) do
            if not Controller.Running then break end
            if m.Parent == workspace:FindFirstChild("Troops") then
                local td = State.TroopDatas and State.TroopDatas[m.Name]
                local lvlObj = m:FindFirstChild("TroopLevel")
                if td and lvlObj then
                    local maxL = (td.GetMaxLevel and td.GetMaxLevel()) or 99
                    for _ = 1, (maxOut and maxL or 1) do
                        if not Controller.Running or m.Parent ~= workspace:FindFirstChild("Troops") then break end
                        local curL = tonumber(lvlObj.Value) or 1
                        local price = curL < maxL and td.GetNextLevelPrice and td.GetNextLevelPrice(curL)
                        if type(price) ~= "number" or F.GetMoney() < price then break end
                        F.FireEvent("UpgradeTroop", m)
                        task.wait(0.18)
                    end
                end
            end
        end
        F.SetStatus(maxOut and "Maxed affordable units" or "Upgraded all x1")
    end)
end

function F.SellUnits(farmsOnly)
    F.SpawnLoop(function()
        for _, m in ipairs(F.GetOwnedTroopModels()) do
            if not Controller.Running then break end
            if F.CanSellTroop(m) then
                local isFarm = farmsOnly and (table.find(F.GetTroopLimitGroupsList(m.Name), "MoneyTroops") ~= nil)
                if (not farmsOnly) or isFarm then
                    F.FireEvent("SellTroop", m)
                    task.wait(0.15)
                end
            end
        end
        F.SetStatus(farmsOnly and "Sold farms" or "Sold all sellable units")
    end)
end

