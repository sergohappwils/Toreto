function F.SanitizeName(name)
    local s = tostring(name or "Default"):gsub("[\\/:*?\"<>|%c]", "_")
    s = s:match("^%s*(.-)%s*$") or "Default"
    return (s ~= "" and s) or "Default"
end

function F.EnsureFolders()
    pcall(function()
        if makefolder and isfolder then
            if not isfolder(ROOT_FOLDER) then makefolder(ROOT_FOLDER) end
            if not isfolder(MACRO_FOLDER) then makefolder(MACRO_FOLDER) end
        end
    end)
end
F.EnsureFolders()

function F.SaveConfig()
    pcall(function()
        if writefile then
            F.EnsureFolders()
            writefile(CONFIG_FILE, S.HttpService:JSONEncode(Config))
        end
    end)
end

function F.LoadConfig()
    pcall(function()
        if isfile and readfile and isfile(CONFIG_FILE) then
            local ok, decoded = pcall(S.HttpService.JSONDecode, S.HttpService, readfile(CONFIG_FILE))
            if ok and type(decoded) == "table" then
                for k, def in pairs(DefaultConfig) do
                    if decoded[k] ~= nil and typeof(decoded[k]) == typeof(def) then
                        Config[k] = decoded[k]
                    end
                end
            end
        end
    end)
end
F.LoadConfig()

function F.ListMacros()
    local names, seen = {}, {}
    pcall(function()
        if listfiles and isfolder and isfolder(MACRO_FOLDER) then
            for _, path in ipairs(listfiles(MACRO_FOLDER)) do
                local file = path:match("([^/\\]+)$")
                if file and file:lower():sub(-5) == ".json" then
                    local base = file:sub(1, -6)
                    if base ~= "" and not seen[base] then
                        seen[base] = true
                        table.insert(names, base)
                    end
                end
            end
        end
    end)
    table.sort(names)
    if #names == 0 then names[1] = "Default" end
    return names
end

function F.SaveMacro(name)
    local clean = F.SanitizeName(name or Config.SelectedMacro)
    Config.SelectedMacro = clean
    F.SaveConfig()
    local ok, err = pcall(function()
        if not writefile then error("No writefile") end
        F.EnsureFolders()
        local md = S.ReplicatedStorage:FindFirstChild("MatchData")
        local payload = {
            Version = 1,
            Name = clean,
            MapId = (md and md:FindFirstChild("MapId") and tostring(md.MapId.Value)) or "",
            TimingMode = Config.RecordOnlySellTimed and "Only Sell" or MacroState.TimingMode,
            Steps = MacroState.Steps,
