    function UI.RefreshSteps()
        stepHdr.Text = string.format("Steps: %d | Cur: %d | Mode: %s", #MacroState.Steps, MacroState.CurrentStep, F.GetEffectiveTimingMode())
        for _, ch in ipairs(stepScroll:GetChildren()) do
            if ch:IsA("TextLabel") then ch:Destroy() end
        end
        local total = #MacroState.Steps
        local startIdx = math.max(1, MacroState.IsPlaying and (MacroState.CurrentStep - 5) or (total - 35))
        local endIdx = math.min(total, startIdx + 45)
        for i = startIdx, endIdx do
            local st = MacroState.Steps[i]
            local line
            if st.Type == "Place" and type(st.Pos) == "table" then
                line = string.format("#%d [W%s %.1fs] Place %s (#%s) @(%.1f,%.1f,%.1f) R%s",
                    i, tostring(st.Wave or 0), tonumber(st.MatchTime) or 0, tostring(st.Troop), tostring(st.UnitId),
                    tonumber(st.Pos[1]) or 0, tonumber(st.Pos[2]) or 0, tonumber(st.Pos[3]) or 0, tostring(st.Rot or 1))
            elseif st.Type == "Upgrade" then
                line = string.format("#%d [W%s %.1fs] Upgrade #%s (%s) -> Lv%s",
                    i, tostring(st.Wave or 0), tonumber(st.MatchTime) or 0, tostring(st.UnitId), tostring(st.Troop or "?"), tostring(st.Level or "+1"))
            elseif st.Type == "Target" then
                line = string.format("#%d [W%s %.1fs] Target #%s -> %s",
                    i, tostring(st.Wave or 0), tonumber(st.MatchTime) or 0, tostring(st.UnitId), tostring(st.Target))
            else
                line = string.format("#%d [W%s %.1fs] Sell #%s (%s)",
                    i, tostring(st.Wave or 0), tonumber(st.MatchTime) or 0, tostring(st.UnitId), tostring(st.Troop or "?"))
            end
            local lbl = Instance.new("TextLabel")
            lbl.LayoutOrder = i
