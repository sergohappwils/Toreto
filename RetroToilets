        local out = {}
        for i, d in ipairs(defs) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(w, 0, 1, 0)
            b.Position = UDim2.new((i - 1) * (w + gap), 0, 0, 0)
            b.BackgroundColor3 = d.Color or Theme.Sidebar
            b.Font = Enum.Font.GothamSemibold
            b.TextSize = 11
            b.TextColor3 = Theme.Text
            b.Text = d.Text
            b.Parent = row
            makeCorner(b, 5)
            makeStroke(b, Theme.Stroke, 1)
            F.TrackConn(b.Activated:Connect(d.Callback))
            out[d.Key or i] = b
        end
        return out
