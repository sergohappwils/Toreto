        writefile(MACRO_FOLDER .. "/" .. clean .. ".json", S.HttpService:JSONEncode(payload))
    end)
    if ok then
        State.FileListDirty = true
        State.StepsDirty = true
        F.SetStatus("Saved: " .. clean .. " (" .. #MacroState.Steps .. " steps)")
    else
        F.SetStatus("Save err: " .. tostring(err))
