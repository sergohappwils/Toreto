function F.StartUIRefreshLoop()
    F.SpawnLoop(function()
        while Controller.Running do
            local md = S.ReplicatedStorage:FindFirstChild("MatchData")
            local mapId = (md and md:FindFirstChild("MapId") and tostring(md.MapId.Value)) or "Lobby"
            local wave, mTime = F.GetMatchWaveAndTime()
            if UI.StatusLabel then
                UI.StatusLabel.Text = string.format("%s | %s | W%d %.0fs | $%d | %s",
                    State.BridgeStatusText, mapId, wave, mTime, F.GetMoney(), MacroState.StatusText)
            end
            if UI.MacroActionBtns then
                local recB, playB = UI.MacroActionBtns.Rec, UI.MacroActionBtns.Play
                if recB then
                    recB.BackgroundColor3 = MacroState.IsRecording and Theme.Red or Theme.Sidebar
                    recB.Text = MacroState.IsRecording and "Stop Rec" or "Record"
                end
                if playB then
                    playB.BackgroundColor3 = MacroState.IsPlaying and Theme.Green or Theme.Sidebar
                    playB.Text = MacroState.IsPlaying and "Pause" or "Replay"
                end
            end
            if State.FileListDirty and UI.RefreshFiles then pcall(UI.RefreshFiles) end
            if State.StepsDirty and UI.RefreshSteps then pcall(UI.RefreshSteps) end
            task.wait(0.25)
        end
    end)
end

-- ============================================================================
-- 11. UNLOAD & STARTUP
-- ============================================================================
function Controller:Unload()
    if not self.Running then return end
    self.Running = false
    MacroState.IsRecording = false
    MacroState.IsPlaying = false
    F.ClearRecordConnections()
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    table.clear(self.Connections)
    for _, c in ipairs(self.BridgeConnections) do pcall(function() c:Disconnect() end) end
    table.clear(self.BridgeConnections)
    for _, th in ipairs(self.Threads) do pcall(task.cancel, th) end
    table.clear(self.Threads)
    if UI.ScreenGui then
        pcall(function() UI.ScreenGui:Destroy() end)
        UI.ScreenGui = nil
    end
    if ENV.LegacyTDMacroHub == self then ENV.LegacyTDMacroHub = nil end
end

F.BuildUI()
F.InitGameData()
F.InitNetwork()
F.SyncEquippedTroops()
if Config.SelectedMacro and Config.SelectedMacro ~= "" then
    F.LoadMacro(Config.SelectedMacro)
end
State.FileListDirty = true
State.StepsDirty = true
F.StartAutomationLoops()
F.StartUIRefreshLoop()

do
    local isLobby = S.ReplicatedStorage:FindFirstChild("IsLobby")
    local md = S.ReplicatedStorage:FindFirstChild("MatchData")
    local curWave = md and md:FindFirstChild("CurrentWave") and tonumber(md.CurrentWave.Value) or 0
    if Config.AutoPlayMacro and #MacroState.Steps > 0 and (not isLobby or isLobby.Value == false) and curWave == 1 and #F.GetOwnedTroopModels() == 0 then
        F.StartPlayback()
    end
end
