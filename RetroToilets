function F.InitGameData()
    local deps = S.ReplicatedStorage:WaitForChild("FrameworkDependencies", 10)
    if not deps then return false end
    local dataFolder = deps:FindFirstChild("7747272c")
    if not dataFolder then
        for _, child in ipairs(deps:GetChildren()) do
            if child:FindFirstChild("TroopDatas") and child:FindFirstChild("MapDatas") then
                dataFolder = child
                break
            end
        end
    end
    if not dataFolder then return false end

    local function safeReq(mod)
        if mod and mod:IsA("ModuleScript") then
            local ok, res = pcall(require, mod)
            if ok then return res end
        end
        return nil
    end

    State.TroopDatas = safeReq(dataFolder:FindFirstChild("TroopDatas")) or {}
    State.TroopsLimitGroups = safeReq(dataFolder:FindFirstChild("TroopsLimitGroups")) or {}
    State.MapDatas = safeReq(dataFolder:FindFirstChild("MapDatas")) or {}
    return true
end

function F.SyncEquippedTroops()
    if not State.TroopDatas then return end
    local pg = State.LocalPlayer and State.LocalPlayer:FindFirstChild("PlayerGui")
    local troopsFrame = pg and pg:FindFirstChild("MainFrames")
        and pg.MainFrames:FindFirstChild("TroopsSelector")
        and pg.MainFrames.TroopsSelector:FindFirstChild("Troops")
    if not troopsFrame then return end

    local list = {}
    for slot = 1, 5 do
        local btn = troopsFrame:FindFirstChild("Troop" .. slot)
        local iconLbl = btn and btn:FindFirstChild("TroopIcon")
        local priceLbl = btn and btn:FindFirstChild("Price")
        local iconId = (iconLbl and (iconLbl:IsA("ImageLabel") or iconLbl:IsA("ImageButton"))) and iconLbl.Image or ""
        local priceTxt = (priceLbl and priceLbl:IsA("TextLabel")) and priceLbl.Text or ""
        local parsedPrice = tonumber((priceTxt:gsub("%$", "")))
        if iconId ~= "" then
            for id, data in pairs(State.TroopDatas) do
                if type(data) == "table" and data.Icon == iconId and (not parsedPrice or data.Price == parsedPrice) then
                    list[slot] = id
                    break
                end
            end
        end
    end
    State.EquippedTroops = list
end

function F.IsTroopEquipped(troopId)
    if next(State.EquippedTroops) == nil then
        F.SyncEquippedTroops()
    end
    if next(State.EquippedTroops) == nil then
        return true
    end
    for _, eqId in pairs(State.EquippedTroops) do
        if eqId == troopId then return true end
    end
    return false
end

