wait(5)
-- ============================================================================
-- RETRO TOILETS // UNIVERSAL HUB LOADER
-- Repo: https://github.com/sergohappwils/Toreto
-- ============================================================================

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local ENV = (type(getgenv) == "function" and getgenv()) or _G
local myLoaderSeq = (ENV.__TORETO_LOADER_SEQ or 0) + 1
ENV.__TORETO_LOADER_SEQ = myLoaderSeq

local function isSuperseded()
    return ENV.__TORETO_LOADER_SEQ ~= myLoaderSeq
end

local REPO_BASE    = "https://raw.githubusercontent.com/sergohappwils/Toreto/refs/heads/main/"
local LOADER_URL   = REPO_BASE .. "Loader"
local LOBBY_URL    = REPO_BASE .. "Lobby"
local MATCH_URL    = REPO_BASE .. "RetroToilets"

local FOLDER       = "LegacyTTD_Macro"
local DELAY_FILE   = FOLDER .. "/startup_delay.txt"
local CACHE_DIR    = FOLDER .. "/cache"
local LOADER_CACHE = CACHE_DIR .. "/loader_cache.luau"
local LOBBY_CACHE  = CACHE_DIR .. "/lobby_cache.luau"
local MATCH_CACHE  = CACHE_DIR .. "/match_cache.luau"

pcall(function()
    if makefolder and isfolder then
        if not isfolder(FOLDER) then makefolder(FOLDER) end
        if not isfolder(CACHE_DIR) then makefolder(CACHE_DIR) end
    end
end)

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService       = game:GetService("HttpService")
local LP                = Players.LocalPlayer or Players.PlayerAdded:Wait()

local bootDelay = 3
pcall(function()
    if isfile and readfile and isfile(DELAY_FILE) then
        local matchStr = readfile(DELAY_FILE):match("([%d%.]+)")
        local num = matchStr and tonumber(matchStr, 10)
        if num and num >= 1 and num <= 60 then
            bootDelay = num
        end
    end
end)

local fromTeleport = (ENV.__TORETO_FROM_TP == true)
ENV.__TORETO_FROM_TP = nil

if fromTeleport or workspace.DistributedGameTime < 12 then
    print(string.format("[Toreto Loader] Waiting %ss before launch...", tostring(bootDelay)))
    task.wait(bootDelay)
end

if isSuperseded() then
    return
end

local function shouldAutoExecute()
    local enabled = true
    pcall(function()
        if isfile and readfile then
            local settingsPath = FOLDER .. "/loader_settings.json"
            if isfile(settingsPath) then
                local ok, decoded = pcall(function()
                    return HttpService:JSONDecode(readfile(settingsPath))
                end)
                if ok and type(decoded) == "table" and decoded.autoExecute == false then
                    enabled = false
                end
            end
        end
    end)
    return enabled
end

local function armTeleportQueue()
    if ENV.__TORETO_TP_ARMED == true then
        return
    end
    local qFunc = queue_on_teleport
        or queueonteleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
        or (delta and delta.queue_on_teleport)
        or (ENV and (ENV.queue_on_teleport or ENV.queueonteleport))

    if not qFunc then
        return
    end

    local payload = string.format([[
        local E = (type(getgenv) == "function" and getgenv()) or _G
        local now = os.clock()
        if E.__TORETO_PAYLOAD_LOCK and (now - E.__TORETO_PAYLOAD_LOCK) < 4 then return end
        E.__TORETO_PAYLOAD_LOCK = now
        E.__TORETO_FROM_TP = true
        if not game:IsLoaded() then game.Loaded:Wait() end
        local ok, src = pcall(function()
            return game:HttpGet(%q .. "?t=" .. tostring(os.time()))
        end)
        if ok and type(src) == "string" and #src > 60 then
            if writefile then pcall(writefile, %q, src) end
            local fn = loadstring(src)
            if fn then task.spawn(fn) return end
        end
        if isfile and readfile and isfile(%q) then
            local fn = loadstring(readfile(%q))
            if fn then task.spawn(fn) end
        end
    ]], LOADER_URL, LOADER_CACHE, LOADER_CACHE, LOADER_CACHE)

    if pcall(qFunc, payload) then
        ENV.__TORETO_TP_ARMED = true
    end
end

if shouldAutoExecute() then
    armTeleportQueue()
end

local function detectPlaceType()
    local lobbyPlaceId = 93712201161812
    local matchPlaceId = 131703399727686

    if game.PlaceId == lobbyPlaceId then
        return "LOBBY"
    elseif game.PlaceId == matchPlaceId then
        return "MATCH"
    end

    local deadline = os.clock() + 15
    while os.clock() < deadline do
        if isSuperseded() then
            return "CANCELLED"
        end

        local isTrading = ReplicatedStorage:FindFirstChild("IsTradingPlaza")
        if isTrading and isTrading.Value == true then
            return "TRADING_PLAZA"
        end

        local isLobby = ReplicatedStorage:FindFirstChild("IsLobby")
        if isLobby and isLobby:IsA("BoolValue") then
            if isLobby.Value == true then
                return "LOBBY"
            end
            if ReplicatedStorage:FindFirstChild("MatchData") then
                return "MATCH"
            end
        end

        if ReplicatedStorage:FindFirstChild("MatchData") or workspace:FindFirstChild("Troops") then
            return "MATCH"
        end

        local zones = workspace:FindFirstChild("Zones")
        if zones and zones:FindFirstChild("SummonZone") then
            return "LOBBY"
        end

        local pg = LP:FindFirstChildOfClass("PlayerGui")
        if pg then
            local lobbyGui = pg:FindFirstChild("Lobby")
            if lobbyGui and lobbyGui:FindFirstChild("SummonShopFrame") then
                return "LOBBY"
            end
            if pg:FindFirstChild("Match") then
                return "MATCH"
            end
        end

        task.wait(0.25)
    end

    if ReplicatedStorage:FindFirstChild("MatchData") then
        return "MATCH"
    end
    return "UNKNOWN"
end

local function fetchAndExecute(url, cachePath, label)
    local src = nil
    for _ = 1, 3 do
        if isSuperseded() then
            return false
        end
        local ok, res = pcall(function()
            return game:HttpGet(url .. "?t=" .. tostring(os.time()))
        end)
        if ok and type(res) == "string" and #res > 100 and not res:match("^404:") then
            src = res
            pcall(function()
                if writefile then writefile(cachePath, src) end
            end)
            break
        end
        task.wait(0.8)
    end

    if isSuperseded() then
        return false
    end

    if not src then
        pcall(function()
            if isfile and readfile and isfile(cachePath) then
                local cached = readfile(cachePath)
                if type(cached) == "string" and #cached > 100 then
                    src = cached
                    warn("[Toreto Loader] GitHub unreachable, loaded cached " .. label)
                end
            end
        end)
    end

    if not src then
        warn("[Toreto Loader] Failed to load " .. label .. " from " .. url)
        return false
    end

    local fn, err = loadstring(src)
    if not fn then
        warn("[Toreto Loader] Syntax error in " .. label .. ": " .. tostring(err))
        return false
    end

    if isSuperseded() then
        return false
    end

    print("[Toreto Loader] Launching " .. label .. "...")
    task.spawn(fn)
    return true
end

local placeType = detectPlaceType()
if isSuperseded() or placeType == "CANCELLED" then
    return
end

if placeType == "LOBBY" then
    if ENV.LegacyTDMacroHub and type(ENV.LegacyTDMacroHub.Unload) == "function" then
        pcall(function() ENV.LegacyTDMacroHub:Unload() end)
    end
    fetchAndExecute(LOBBY_URL, LOBBY_CACHE, "Lobby Hub (Lobby)")
elseif placeType == "MATCH" then
    if ENV.RetroToiletsLobbyHub and type(ENV.RetroToiletsLobbyHub.Unload) == "function" then
        pcall(function() ENV.RetroToiletsLobbyHub.Unload() end)
    end
    fetchAndExecute(MATCH_URL, MATCH_CACHE, "Match Macro (RetroToilets)")
else
    print("[Toreto Loader] Non-lobby/match place detected (" .. tostring(placeType) .. "); standing by.")
end
