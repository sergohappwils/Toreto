local function letterToNumber(ch)
    local num = tonumber(ch)
    if num then return num end
    local idx = string.find("abcdefghijklmnopqrstuvwxyz-", string.lower(ch), 1, true)
    return tonumber(idx) or 0
end

local function getHashedEventName(eventName, mode)
    local guidObj, timeObj = State.MatchGuidObj, State.GameTimeValObj
    if not (guidObj and timeObj) then
        return nil
    end

    local guid = tostring(guidObj.Value)
    local gt = tonumber(timeObj.Value) or 1
    if guid ~= State.HashCacheGuid or gt ~= State.HashCacheTime then
        table.clear(State.HashCache)
        State.HashCacheGuid = guid
        State.HashCacheTime = gt
    end

    local cacheKey = tostring(mode) .. ":" .. tostring(eventName)
    if State.HashCache[cacheKey] then
        return State.HashCache[cacheKey]
    end

    local sub1 = string.sub(guid, gt, gt)
    local idx2 = math.clamp(gt + 3, 1, 32)
    local sub2 = string.sub(guid, idx2, idx2)
    local prefix = (mode == "FuncRecieve") and "FR_" or "UR_"

    if RunService:IsStudio() then
        local studioName = prefix .. tostring(eventName)
        State.HashCache[cacheKey] = studioName
        return studioName
    end

    local fmt = letterToNumber(sub2) > 17
        and "%s-%s_%s'%s:%s|%s/%s!%s=%s@%s(%s$%s*%s&%s^%s?%s{%s"
        or "%s/%s!%s=%s@%s(%s$%s*%s&%s^%s?%s{%s-%s_%s'%s:%s|%s"

    local pVer = tostring(game.PlaceVersion)
    local cId = tostring(game.CreatorId)
    local pId = tostring(game.PlaceId)
    local gId = tostring(game.GameId)
    local eStr = tostring(eventName)

    local formatted = string.format(
        fmt, eStr, pId, pVer, cId, sub1, sub2, eStr, pId,
        sub1, pVer, cId, gId, sub1, eStr, pId, sub1, sub2
    )

    local n1 = letterToNumber(sub1)
    local digest
    if n1 > 15 then
        digest = Hash.sha3_224(formatted)
    elseif n1 > 6 then
        digest = Hash.sha512_224(formatted)
    else
        digest = Hash.sha512_256(formatted)
    end

    local full = prefix .. digest
    State.HashCache[cacheKey] = full
    return full
end

local function packArgs(...)
    local packed = table.pack(...)
    local out, nilId = {}, State.NilIdentifier
    for i = 1, packed.n do
        out[i] = (packed[i] == nil) and nilId or packed[i]
    end
    return out
end

local function unpackArgs(tbl)
    if type(tbl) ~= "table" then return end
    local nilId, n = State.NilIdentifier, 0
    for k in pairs(tbl) do
        if type(k) == "number" and k > n then
            n = k
        end
    end
    local copy = {}
    for i = 1, n do
        copy[i] = (tbl[i] ~= nilId) and tbl[i] or nil
    end
    return table.unpack(copy, 1, n)
end

local function resolveEventId(eventName)
    if not State.IdStorage then
        return nil
    end
    local hashed = getHashedEventName("Event-" .. eventName, "Event")
    if not hashed then
        return nil
    end
    local strVal = State.IdStorage:FindFirstChild(hashed)
    if strVal and strVal:IsA("StringValue") then
        return strVal.Value
    end
    return nil
end

local function fireBridgeEvent(eventName, ...)
    if not State.DataRemote then
        return false
    end
    local id = resolveEventId(eventName)
    if not id then
        return false
    end
    table.insert(State.OutboundQueue, packArgs(...))
    table.insert(State.OutboundQueue, id)
    return true
end

local function bindInboundEvent(eventName, callback)
    local hashed = getHashedEventName("Event-" .. eventName, "Event")
    if not (hashed and State.IdStorage) then
        return
    end
    local function attach(child)
        if child and child.Name == hashed and child:IsA("StringValue") then
            State.InboundHandlers[child.Value] = State.InboundHandlers[child.Value] or {}
            table.insert(State.InboundHandlers[child.Value], callback)
        end
    end
    local existing = State.IdStorage:FindFirstChild(hashed)
    if existing then
        attach(existing)
    end
    trackConn(State.IdStorage.ChildAdded:Connect(attach))
end

local function initNetworkWire()
    State.DataRemote = ReplicatedStorage:WaitForChild("dataRemoteEvent", 15)
    State.IdStorage = ReplicatedStorage:WaitForChild("identifierStorage", 15)
    State.MatchGuidObj = ReplicatedStorage:WaitForChild("MatchGuid", 15)
    State.GameTimeValObj = ReplicatedStorage:WaitForChild("GameTimeVal", 15)

    if not (State.DataRemote and State.IdStorage and State.MatchGuidObj and State.GameTimeValObj) then
        State.WireReady = false
        State.WireStatus = "Wire Missing RS"
        return false
    end

    local nilObj = State.IdStorage:WaitForChild("NilIdentifier", 10)
    if nilObj and nilObj:IsA("StringValue") then
        State.NilIdentifier = nilObj.Value
    end

    trackConn(RunService.PostSimulation:Connect(function()
        if State.Unloaded then
            return
        end
        local q = State.OutboundQueue
        if #q > 0 and State.DataRemote then
            local batch = table.clone(q)
            table.clear(q)
            State.DataRemote:FireServer(batch)
        end
    end))

    trackConn(State.DataRemote.OnClientEvent:Connect(function(packetMap)
        if State.Unloaded or type(packetMap) ~= "table" then
            return
        end
        for idChar, payloads in pairs(packetMap) do
            local handlers = State.InboundHandlers[idChar]
            if handlers and type(payloads) == "table" then
                for _, argsTbl in ipairs(payloads) do
                    for _, fn in ipairs(handlers) do
                        task.spawn(fn, unpackArgs(argsTbl))
                    end
                end
            end
        end
    end))

    bindInboundEvent("1TroopSummoned", function(troopId)
        State.SummonCount += 1
        State.LastSummonConfirmedAt = os.clock()
        State.LastUnitText = tostring(troopId or "Unit")
        State.StatusText = "Summoned 1x: " .. State.LastUnitText
    end)

    bindInboundEvent("10TroopsSummoned", function(troopsList)
        State.SummonCount += 10
        State.LastSummonConfirmedAt = os.clock()
        local lastOne = (type(troopsList) == "table" and troopsList[#troopsList]) or "10 Units"
        State.LastUnitText = tostring(lastOne)
        State.StatusText = "Summoned 10x (Last: " .. State.LastUnitText .. ")"
    end)

    local s1 = resolveEventId("Summon1")
    local s10 = resolveEventId("Summon10")
    if s1 and s10 then
        State.WireReady = true
        State.WireStatus = "Wire OK (" .. s1 .. "/" .. s10 .. ")"
    else
        State.WireReady = false
        State.WireStatus = "Waiting for Summon IDs..."
    end

    return true
end

