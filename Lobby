-- ============================================================================
-- 6. SUMMON PRIORITY LOOP (NO AUTO-UNCHECK ON REFUSAL)
-- ============================================================================
local function decideSummonAction(coins)
    local want900 = State.Check900
    local want100 = State.Check100

    if not want900 and not want100 then
        return nil, "Idle"
    end

    if want900 and want100 then
        if coins >= Config.Cost10x then
            return "Summon10", "Sending 900 Summon (10x)"
        elseif coins >= Config.Cost1x then
            return "Summon1", "Below 900 -> Sending 100 Summon (1x)"
        else
            return nil, "Waiting for 100 coins (kept checked)"
        end
    elseif want900 then
        if coins >= Config.Cost10x then
            return "Summon10", "Sending 900 Summon (10x)"
        end
        return nil, "Waiting for 900 coins (kept checked)"
    else
        if coins >= Config.Cost1x then
            return "Summon1", "Sending 100 Summon (1x)"
        end
        return nil, "Waiting for 100 coins (kept checked)"
    end
end

local function processSummonTick()
    if State.Unloaded then
        return
    end

    if not State.WireReady then
        local s1 = resolveEventId("Summon1")
        local s10 = resolveEventId("Summon10")
        if s1 and s10 then
            State.WireReady = true
            State.WireStatus = "Wire OK (" .. s1 .. "/" .. s10 .. ")"
        else
            State.StatusText = "Waiting for Summon IDs (kept checked)"
            return
        end
    end

    local eventName, statusMsg = decideSummonAction(State.CurrentCoins)
    if not eventName then
        State.StatusText = statusMsg
        return
    end

    local now = os.clock()
    if (now - State.LastSummonSentAt) < Config.SummonInterval then
        return
    end

    -- Build clean autoSell table snapshot matching SummonHandler u15 keys
    local autoSellPayload = {
        Basic = State.AutoSell.Basic == true,
        Uncommon = State.AutoSell.Uncommon == true,
        Rare = State.AutoSell.Rare == true,
        Epic = State.AutoSell.Epic == true,
        Legendary = State.AutoSell.Legendary == true,
    }

    State.LastSummonSentAt = now
    local sent = fireBridgeEvent(eventName, autoSellPayload)
    if sent then
        State.StatusText = statusMsg
    else
        -- Never uncheck State.Check900 or State.Check100 if refused or missing
        State.StatusText = "Refused / Retrying (kept checked)"
    end
end

