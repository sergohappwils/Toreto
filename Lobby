    local currLayout = coinAmount and coinAmount:FindFirstChild("CurrencyLayout")
    local amountLbl = currLayout and currLayout:FindFirstChild("AmountLabel")
    if amountLbl and amountLbl:IsA("TextLabel") then
        local cleaned = string.gsub(amountLbl.Text, "[,%s]", "")
        local parsed = tonumber(cleaned)
        if parsed then
            return parsed
        end
    end

