local function applyCheckboxVisual(box, gradient, stroke, checkShape, isChecked, isCreamTheme)
    if isChecked then
        box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        gradient.Enabled = true
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.CheckOnTop),
            ColorSequenceKeypoint.new(1, Theme.CheckOnBottom),
        })
        stroke.Color = Theme.CheckOnStroke
        checkShape.Visible = true
    else
        gradient.Enabled = false
        box.BackgroundColor3 = isCreamTheme and Theme.CheckOffCream or Theme.CheckOffDark
        stroke.Color = isCreamTheme and Theme.CreamStroke or Theme.LeftCardStroke
        checkShape.Visible = false
    end
end

