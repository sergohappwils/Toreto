    local function sha512ext(bits, msg)
        local totalBytes, buf = 0, ""
        local hLo = table.pack(table.unpack(u117[bits]))
        local hHi = table.pack(table.unpack(u369[bits]))
        local function feed(chunk)
            if not chunk then
                if buf then
                    local t = table.create(3)
                    t[1], t[2], t[3] = buf, "\128", string.rep("\0", (-17 - totalBytes) % 128 + 9)
                    buf = nil
                    totalBytes *= 1.1102230246251565e-16
                    for i = 4, 10 do
                        totalBytes = totalBytes % 1 * 256
                        t[i] = string.char(totalBytes - totalBytes % 1)
                    end
                    local tail = table.concat(t)
                    sha512_feed_128(hLo, hHi, tail, 0, #tail)
                    local nWords = math.ceil(bits / 64)
                    for i = 1, nWords do
                        hLo[i] = string.format("%08x", hHi[i] % 4294967296) .. string.format("%08x", hLo[i] % 4294967296)
                    end
                    hHi = nil
                    hLo = string.sub(table.concat(hLo, "", 1, nWords), 1, bits / 4)
                end
                return hLo
            end
            local len = #chunk
            totalBytes += len
            local offset = 0
            if buf ~= "" and #buf + len >= 128 then
                offset = 128 - #buf
                sha512_feed_128(hLo, hHi, buf .. string.sub(chunk, 1, offset), 0, 128)
                buf = ""
            end
            local rem = len - offset
            local mod = rem % 128
            sha512_feed_128(hLo, hHi, chunk, offset, rem - mod)
            buf ..= string.sub(chunk, len + 1 - mod)
            return feed
        end
