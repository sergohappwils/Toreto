State.CurrentCoins = readCoins()
refreshUI()

trackConn(RunService.Heartbeat:Connect(function(dt)
    if State.Unloaded then
        return
    end

    LoopTimers.SyncElapsed += dt
    LoopTimers.SummonElapsed += dt

    if LoopTimers.SyncElapsed >= Config.SyncInterval then
        LoopTimers.SyncElapsed = 0
        State.CurrentCoins = readCoins()
        if next(GameSyncHooks) == nil then
            bindGameAutoSellUI()
        end
        refreshUI()
    end

    if LoopTimers.SummonElapsed >= Config.SummonInterval then
        LoopTimers.SummonElapsed = 0
        if State.Check900 or State.Check100 then
            processSummonTick()
            refreshUI()
        end
    end
end))
