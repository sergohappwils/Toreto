local function refreshUI()
    if State.Unloaded then
        return
    end

    if UI.Row900 then
        applyCheckboxVisual(UI.Row900.Box, UI.Row900.Gradient, UI.Row900.Stroke, UI.Row900.CheckShape, State.Check900, false)
    end
    if UI.Row100 then
        applyCheckboxVisual(UI.Row100.Box, UI.Row100.Gradient, UI.Row100.Stroke, UI.Row100.CheckShape, State.Check100, false)
    end

    for _, rarityKey in ipairs(RARITY_KEYS) do
        local ref = UI.RarityRows[rarityKey]
        if ref then
            applyCheckboxVisual(ref.Box, ref.Gradient, ref.Stroke, ref.CheckShape, State.AutoSell[rarityKey] == true, true)
        end
    end

    if UI.CoinLabel then
        UI.CoinLabel.Text = string.format("Coins: %d  |  Summoned: %d", math.floor(State.CurrentCoins), State.SummonCount)
    end

    if UI.CoinProgressFill then
        local ratio = math.clamp(State.CurrentCoins / Config.Cost10x, 0, 1)
        UI.CoinProgressFill.Size = UDim2.new(ratio, 0, 1, 0)
    end

    if UI.RuleLabel then
        if State.Check900 and State.Check100 then
            UI.RuleLabel.Text = "Priority: 900 (10x) -> Below 900: 100 (1x)"
        elseif State.Check900 then
            UI.RuleLabel.Text = "Mode: 900 (10x) Only (Keep Checked)"
        elseif State.Check100 then
            UI.RuleLabel.Text = "Mode: 100 (1x) Only (Keep Checked)"
        else
            UI.RuleLabel.Text = "Mode: Idle"
        end
    end

    if UI.StatusLabel then
        UI.StatusLabel.Text = State.WireStatus .. " | " .. State.StatusText
    end

    if UI.SyncLabel then
        UI.SyncLabel.Text = string.format("Game UI Sync: %d/5 On", countActiveAutoSell())
    end
end

local function unloadHub()
    if State.Unloaded then
        return
    end
    State.Unloaded = true
    for i = #Connections, 1, -1 do
        local conn = Connections[i]
        if conn and conn.Connected then
            pcall(function() conn:Disconnect() end)
        end
        Connections[i] = nil
    end
    table.clear(GameSyncHooks)
    if UI.ScreenGui then
        pcall(function() UI.ScreenGui:Destroy() end)
        UI.ScreenGui = nil
    end
    if ENV.RetroToiletsLobbyHub then
        ENV.RetroToiletsLobbyHub = nil
    end
end

