    end

    local function keccak(blockSize, digestBytes, isShake, msg)
        local stLo, stHi = table.create(25, 0), table.create(25, 0)
        local len = #msg
        local mod = len % blockSize
        keccak_feed(stLo, stHi, msg, 0, len - mod, blockSize)
        local buf = string.sub(msg, len + 1 - mod)
        local pad = isShake and 31 or 6
        local padded = buf .. ((#buf + 1 == blockSize) and string.char(pad + 128) or (string.char(pad) .. string.rep("\0", (-2 - #buf) % blockSize) .. "\128"))
        keccak_feed(stLo, stHi, padded, 0, #padded, blockSize)
        local qIdx, qCap, qBuf = 0, math.floor(blockSize / 8), {}
        local function getQWords(n)
            if qCap <= qIdx then
                keccak_feed(stLo, stHi, "\0\0\0\0\0\0\0\0", 0, 8, 8)
                qIdx = 0
            end
            local count = math.floor(math.min(n, qCap - qIdx))
            for i = 1, count do
                qBuf[i] = string.format("%08x", stHi[qIdx + i] % 4294967296) .. string.format("%08x", stLo[qIdx + i] % 4294967296)
            end
            qIdx += count
            return string.gsub(table.concat(qBuf, "", 1, count), "(..)(..)(..)(..)(..)(..)(..)(..)", "%8%7%6%5%4%3%2%1"), count * 8
        end
        local outParts, left, nParts = {}, digestBytes, 0
        while left >= 8 do
            local chunk, taken = getQWords(left / 8)
            nParts += 1
            outParts[nParts] = chunk
            left -= taken
        end
        if left > 0 then
            local tail = getQWords(1)
            nParts += 1
            outParts[nParts] = string.sub(tail, 1, left * 2)
        end
        return table.concat(outParts, "", 1, nParts)
    end

    return {
        sha512_224 = function(str) return sha512ext(224, str) end,
        sha512_256 = function(str) return sha512ext(256, str) end,
        sha3_224 = function(str) return keccak(144, 28, false, str) end,
