local function isInGameToggleOn(btn)
    if not (btn and btn:IsA("GuiObject")) then
        return false
    end
    if btn:IsA("TextButton") or btn:IsA("TextLabel") then
        local upper = string.upper(btn.Text)
        if upper == "ON" then
            return true
        elseif upper == "OFF" then
            return false
        end
    end
    local bg = btn.BackgroundColor3
    return bg.G > (bg.R + 0.15) and bg.G > (bg.B + 0.15)
end

local function countActiveAutoSell()
    local count = 0
    for _, key in ipairs(RARITY_KEYS) do
        if State.AutoSell[key] == true then
            count += 1
        end
    end
    return count
end

local function bindGameAutoSellUI()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local lobby = pg and pg:FindFirstChild("Lobby")
    local summonShop = lobby and lobby:FindFirstChild("SummonShopFrame")
    local autoSellFolder = summonShop and summonShop:FindFirstChild("AutoSell")
    if not autoSellFolder then
        State.SyncText = "Game UI Sync: Waiting for Lobby"
        return false
    end

    local hookedAny = false
    for _, rarityKey in ipairs(RARITY_KEYS) do
        local rowFrame = autoSellFolder:FindFirstChild(rarityKey)
        local btn = rowFrame and rowFrame:FindFirstChild("OnAndOff")
        if btn and not GameSyncHooks[rarityKey] then
            hookedAny = true
            local initialState = isInGameToggleOn(btn)
            if initialState == true then
                State.AutoSell[rarityKey] = true
            end

            GameSyncHooks[rarityKey] = btn
            trackConn(btn:GetPropertyChangedSignal("Text"):Connect(function()
                if State.Unloaded then return end
                State.AutoSell[rarityKey] = isInGameToggleOn(btn)
                State.SyncText = string.format("Game UI Sync: %d/5 Active", countActiveAutoSell())
            end))
            trackConn(btn:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
                if State.Unloaded then return end
                State.AutoSell[rarityKey] = isInGameToggleOn(btn)
                State.SyncText = string.format("Game UI Sync: %d/5 Active", countActiveAutoSell())
            end))
        end
    end

    if next(GameSyncHooks) ~= nil then
        State.SyncText = string.format("Game UI Sync: %d/5 Active", countActiveAutoSell())
        return hookedAny
    end
    return false
end

